{"version":3,"term":{"cols":92,"rows":30},"timestamp":1791466343,"command":"./scripts/demo.sh","env":{"SHELL":"/bin/zsh"}}
[0.368, "o", "\r\n\u001b[1m1. On my Mac, devenv shell gives the patched git\u001b[0m\r\n"]
[1.213, "o", "\u001b[2m$ devenv shell -- git-identity\u001b[0m\r\n"]
[1.430, "o", "   version: git version 2.55.0\r\n   patch:   67b647b1f90e7c15…\r\n"]
[1.513, "o", "\r\n\u001b[1m2. Every force push is refused locally\u001b[0m\r\n"]
[1.207, "o", "\u001b[2m$ devenv shell -- force-push-probe\u001b[0m\r\n"]
[2.160, "o", "   \u001b[32mallowed\u001b[0m fast-forward git push origin HEAD:main\r\n"]
[0.095, "o", "   \u001b[31mrefused\u001b[0m git push --force\r\n"]
[0.028, "o", "   \u001b[31mrefused\u001b[0m git push -f\r\n"]
[0.037, "o", "   \u001b[31mrefused\u001b[0m git push --force-with-lease\r\n"]
[0.041, "o", "   \u001b[31mrefused\u001b[0m git push origin +HEAD:main\r\n"]
[0.028, "o", "   \u001b[31mrefused\u001b[0m git push with +refspec from config\r\n"]
[0.033, "o", "   \u001b[31mrefused\u001b[0m git push --mirror\r\n"]
[0.008, "o", "   remote main unchanged at d073f516a5b77d5f0825f7069c8157881f3431ff\r\n   FORCE_PUSH_REFUSED=6\r\n"]
[1.524, "o", "\r\n\u001b[1m3. The live Cloudflare Container runs the same git\u001b[0m\r\n"]
[1.227, "o", "\u001b[2m$ curl https://nix-cf-proof.coy.workers.dev/probe/sandbox\u001b[0m\r\n"]
[2.229, "o", "   version: git version 2.55.0\r\n   patch:   67b647b1f90e7c15…\r\n"]
[0.020, "o", "   kernel:  6.18.54-cloudflare-microvm-2026.9.16\r\n"]
[1.510, "o", "\r\n\u001b[1m4. Every force push is refused in the container\u001b[0m\r\n"]
[1.228, "o", "   \u001b[32mallowed\u001b[0m fast-forward git push origin HEAD:main\r\n   \u001b[31mrefused\u001b[0m git push --force\r\n   \u001b[31mrefused\u001b[0m git push -f\r\n   \u001b[31mrefused\u001b[0m git push --force-with-lease\r\n   \u001b[31mrefused\u001b[0m git push origin +HEAD:main\r\n   \u001b[31mrefused\u001b[0m git push with +refspec from config\r\n   \u001b[31mrefused\u001b[0m git push --mirror\r\n   remote main unchanged at 76d2427c750bf468f519a7bf538e0ce5ca97ee66\r\n   FORCE_PUSH_REFUSED=6\r\n\r\n"]
[1.514, "o", "\r\n\u001b[1m5. The image was built on Cloudflare, not on this laptop\u001b[0m\r\n"]
[1.218, "o", "   built in: Cloudflare ewr15\r\n   kernel:   6.18.54-cloudflare-microvm-2026.9.16\r\n   digest:   sha256:5a455a810b390dad…\r\n"]
[1.509, "o", "\r\n\u001b[1m6. Full NixOS boots there too\u001b[0m\r\n"]
[1.257, "o", "   PID 1: /run/current-system/systemd/lib/systemd/systemd\r\n"]
[0.011, "o", "   state: degraded\r\n"]
[1.505, "o", "\r\n\u001b[1m\u001b[32m./proof.sh → gate: pass\u001b[0m\r\n\r\n"]
[2.518, "x", "0"]
