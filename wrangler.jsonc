{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nix-cf-proof",
  "main": "src/index.ts",
  "account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "ACCOUNT_ID": "bfcb6ac5b3ceaf42a09607f6f7925823" },
  "containers": [
    {
      "class_name": "SandboxComputer",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "image": "registry.cloudflare.com/bfcb6ac5b3ceaf42a09607f6f7925823/nix-cf-proof@sha256:5e764169f51d3aa9bdf01900f3f185a786c482c50596c60839d252632a74a676"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "SandboxComputer" }]
  },
  "exports": {
    "SandboxComputer": { "type": "durable-object", "storage": "sqlite" }
  }
}
