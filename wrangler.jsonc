{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nix-cf-proof",
  "main": "src/index.ts",
  "account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "SandboxComputer",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "./container/Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "SandboxComputer" }]
  },
  "exports": {
    "SandboxComputer": { "type": "durable-object", "storage": "sqlite" }
  }
}
