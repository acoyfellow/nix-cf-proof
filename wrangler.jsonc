{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nix-cf-proof",
  "main": "src/index.ts",
  "account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": { "ACCOUNT_ID": "bfcb6ac5b3ceaf42a09607f6f7925823" },
  "containers": [
    {
      "class_name": "SandboxComputer",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "image": "registry.cloudflare.com/bfcb6ac5b3ceaf42a09607f6f7925823/nix-cf-proof@sha256:a1a62ac1c013177429b24e88fbef1c07a10e023208b67af33a4d06a6f7b76e1b"
        }
      }
    },
    {
      "class_name": "VirtualMachine",
      "scheduling_policy": "durable_object",
      "images": {
        "nixos": {
          "image": "registry.cloudflare.com/bfcb6ac5b3ceaf42a09607f6f7925823/nix-cf-proof@sha256:a1a62ac1c013177429b24e88fbef1c07a10e023208b67af33a4d06a6f7b76e1b"
        },
        "ubuntu": {
          "image": "registry.cloudflare.com/bfcb6ac5b3ceaf42a09607f6f7925823/vm-ubuntu@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "SandboxComputer" },
      { "name": "VM", "class_name": "VirtualMachine" }
    ]
  },
  "exports": {
    "SandboxComputer": { "type": "durable-object", "storage": "sqlite" },
    "VirtualMachine": { "type": "durable-object", "storage": "sqlite" }
  }
}
